@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Projection on Order Items'
@Metadata.ignorePropagatedAnnotations: false
@Metadata.allowExtensions: true
define view entity ZC_SV_ORD_ITEM
  as projection on ZR_SV_ORD_ITEM
{
  key ItemNo,
  key OrderId,
      Product,
      Quantity,
      Uom,
      UnitPrice,
      Currency,
      Createdby,
      Createdat,
      Lastchangedby,
      Lastchangedat,
      /* Associations */
      _OrderHeader : redirected to parent ZC_SV_ORDER
}
